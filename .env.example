# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se sube al repositorio.

# --- Base de datos (Supabase) ---------------------------------------------
# DATABASE_URL usa el pooler (puerto 6543) porque Vercel abre y cierra
# conexiones constantemente. DIRECT_URL apunta al puerto 5432 y solo la usan
# las migraciones de Prisma.
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Login de administradores (Google OAuth) ------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Emails autorizados a entrar al panel, separados por comas.
ADMIN_EMAILS="artikorealestate@gmail.com"

# --- Google Drive ----------------------------------------------------------
# Carpeta raiz de Artiko donde cuelga "Clientes interesados".
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# Credenciales de la cuenta que posee el Drive (artikorealestate@gmail.com).
# El refresh token se obtiene una sola vez con el script de autorizacion.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""

# --- Emails (SMTP de Gmail con contrasena de aplicacion) ------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
# Contrasena de aplicacion de 16 caracteres, no la contrasena normal de la cuenta.
SMTP_PASSWORD=""
GMAIL_FROM_ADDRESS="Artiko Real Estate <artikorealestate@gmail.com>"
# Destinatarios del aviso interno, separados por comas.
INTERNAL_NOTIFICATION_EMAILS="info@artikore.com"

# --- Aplicacion ------------------------------------------------------------
# URL publica, usada en los enlaces de los emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Datos que ve el interesado en el pie del formulario: saber a quien esta
# entregando su documentacion es lo que hace que termine de rellenarlo.
NEXT_PUBLIC_WEBSITE_URL="https://artikore.com"
NEXT_PUBLIC_CONTACT_EMAIL="info@artikore.com"
